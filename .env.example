# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Произвольная секретная строка: проверка подлинности webhook-запросов Telegram
# и одновременно ключ для разовой регистрации webhook через /api/telegram?setup=<значение>
TELEGRAM_WEBHOOK_SECRET=

# Публичный URL проекта на Vercel, без слэша на конце, например https://massage-bot.vercel.app
APP_URL=

# Upstash QStash (консоль Upstash -> QStash; URL — регионального endpoint'а)
QSTASH_URL=https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=
# Ключи подписи QStash (опционально, для будущей верификации подписи; сейчас advance защищён CRON_SECRET)
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Upstash Redis (консоль Upstash -> Redis -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Произвольная секретная строка: защита служебного endpoint /api/session/advance,
# который вызывает QStash (секрет передаётся в теле отложенного сообщения)
CRON_SECRET=
